@model AbujalWebsite.Models.Insight
@{
    ViewData["Title"] = Model.Title;
}

<section class="page-header">
    <div class="container">
        <h1>@Model.Title</h1>
        <p class="mb-0">@Model.Type | @Model.PublishDate.ToString("MMMM d, yyyy")</p>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row">
            <div class="col-lg-8">
                <p>@Model.Summary</p>
                @if (!string.IsNullOrWhiteSpace(Model.DownloadUrl))
                {
                    <a class="btn btn-orange" href="@Model.DownloadUrl">Download <i class="bi bi-download"></i></a>
                }
                <div class="mt-4">
                    <a class="btn btn-outline-navy" asp-action="Index">Back to Insights</a>
                </div>
            </div>
        </div>
    </div>
</section>
