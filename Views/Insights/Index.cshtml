@model IReadOnlyList<AbujalWebsite.Models.Insight>
@{
    ViewData["Title"] = "Insights";
}

<section class="page-header">
    <div class="container">
        <h1>Insights &amp; Publications</h1>
        <p class="mb-0">Research briefs, reports and lessons learned from our engagements.</p>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row g-4">
            @foreach (var insight in Model)
            {
                <div class="col-md-6">
                    <div class="service-card">
                        <span class="badge badge-category mb-2">@insight.Type</span>
                        <h3><a class="text-decoration-none" style="color: var(--navy);" asp-action="Details" asp-route-slug="@insight.Slug">@insight.Title</a></h3>
                        <p class="text-muted small mb-1">@insight.PublishDate.ToString("MMMM yyyy")</p>
                        <p class="text-muted small">@insight.Summary</p>
                        <a class="card-link" asp-action="Details" asp-route-slug="@insight.Slug">Read more <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
