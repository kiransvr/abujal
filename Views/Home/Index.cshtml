@using AbujalWebsite.Models
@{
    ViewData["Title"] = "Home";
    var services = (IReadOnlyList<Service>)ViewBag.Services;
    var featuredProjects = (IReadOnlyList<Project>)ViewBag.FeaturedProjects;
}

<section class="hero">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <h1 class="display-5">Turning Knowledge and Evidence into <span class="highlight">Sustainable Impact</span></h1>
                <p class="lead">
                    Abujal Training, Research and Consultancy PLC provides professional research, consultancy,
                    training and institutional capacity-building solutions for government institutions,
                    development organizations, financial institutions, NGOs and private-sector organizations.
                </p>
                <div class="d-flex flex-wrap gap-3 mt-4">
                    <a class="btn btn-orange btn-lg" asp-controller="Services" asp-action="Index">Our Services <i class="bi bi-arrow-right"></i></a>
                    <a class="btn btn-outline-navy btn-lg" asp-controller="About" asp-action="Index">Learn More <i class="bi bi-arrow-right"></i></a>
                </div>
            </div>
            <div class="col-lg-6 hero-image mt-4 mt-lg-0">
                <img src="~/images/hero.png" alt="Abujal consultant" />
            </div>
        </div>
    </div>
</section>

<section class="stats-strip">
    <div class="container">
        <div class="row g-3">
            <div class="col-6 col-lg-3">
                <div class="stat-item">
                    <i class="bi bi-person-badge"></i>
                    <div><span class="stat-number">8+ Years</span>of Business Experience</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="stat-item">
                    <i class="bi bi-award"></i>
                    <div><span class="stat-number">15+ Years</span>Average Expert Experience</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="stat-item">
                    <i class="bi bi-globe2"></i>
                    <div><span class="stat-number">8+ Countries</span>International Network</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="stat-item">
                    <i class="bi bi-bank"></i>
                    <div><span class="stat-number">100+</span>Training &amp; Consultancy Assignments</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row align-items-start mb-4">
            <div class="col-lg-4">
                <h2 class="section-title">Our Areas of Expertise</h2>
                <p class="text-muted">
                    We deliver integrated solutions across six core service areas, combining research, knowledge
                    and practical experience to drive sustainable development.
                </p>
                <a class="btn btn-orange" asp-controller="Services" asp-action="Index">Explore Our Services <i class="bi bi-arrow-right"></i></a>
            </div>
            <div class="col-lg-8">
                <div class="row g-3">
                    @foreach (var service in services)
                    {
                        <div class="col-sm-6 col-lg-4">
                            <div class="service-card">
                                <i class="bi @service.Icon service-icon"></i>
                                <h3>@service.Title</h3>
                                <p class="text-muted small mb-2">@service.Summary</p>
                                <a class="card-link" asp-controller="Services" asp-action="Details" asp-route-slug="@service.Slug">
                                    <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<section class="impact-band py-5">
    <div class="container">
        <div class="d-none d-lg-flex justify-content-between mb-4 impact-photo-strip">
            <img src="~/images/impact-team.png" alt="Abujal team engaging with community members" />
            <img src="~/images/impact-mountain.png" alt="Ethiopian highlands landscape" />
        </div>
        <div class="row g-4 align-items-center">
            <div class="col-lg-7">
                <h2 class="section-title">Our Impact</h2>
                <p class="text-muted">
                    From Addis Ababa to beyond, we work with government institutions, financial organizations,
                    NGOs and development partners to create knowledge, build capacity and deliver lasting change.
                </p>
                <div class="row text-center mt-3">
                    <div class="col-4 impact-stat">
                        <span class="impact-number">8+</span>Years in Business
                    </div>
                    <div class="col-4 impact-stat">
                        <span class="impact-number">8</span>Professional Staff
                    </div>
                    <div class="col-4 impact-stat">
                        <span class="impact-number">15+</span>Years Average Expert Experience
                    </div>
                </div>
            </div>
            <div class="col-lg-5 sectors-band p-4 rounded">
                <h2 class="section-title">Sectors We Serve</h2>
                <ul class="sectors-list">
                    <li><i class="bi bi-bank"></i>Financial Services</li>
                    <li><i class="bi bi-globe"></i>Development</li>
                    <li><i class="bi bi-building"></i>Government &amp; Public Institutions</li>
                    <li><i class="bi bi-heart"></i>Health</li>
                    <li><i class="bi bi-flower1"></i>Agriculture</li>
                    <li><i class="bi bi-graph-up-arrow"></i>SMEs &amp; Entrepreneurship</li>
                    <li><i class="bi bi-people"></i>Gender &amp; Social Inclusion</li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="section-title mb-0">Featured Projects</h2>
            <a asp-controller="Projects" asp-action="Index" class="card-link">View All Projects <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="row g-4">
            @foreach (var project in featuredProjects)
            {
                <div class="col-md-4">
                    <div class="project-card">
                        <img src="@project.ImageUrl" alt="@project.Title" />
                        <div class="project-body">
                            <h3>
                                <a class="text-decoration-none" style="color: var(--navy);" asp-controller="Projects" asp-action="Details" asp-route-slug="@project.Slug">@project.Title</a>
                            </h3>
                            <p class="text-muted small">@project.Summary</p>
                            <span class="badge badge-category">@project.Category</span>
                            <span class="text-muted small ms-2"><i class="bi bi-geo-alt"></i> @project.Country | @project.Year</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

