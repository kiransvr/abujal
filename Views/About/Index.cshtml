@{
    ViewData["Title"] = "About Us";
}

<section class="page-header">
    <div class="container">
        <h1>About Abujal</h1>
        <p class="mb-0">Turning knowledge and evidence into sustainable impact.</p>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-lg-6">
                <h2 class="section-title">Who We Are</h2>
                <p>
                    Abujal Training, Research and Consultancy PLC is an Ethiopia-based firm providing professional
                    research, consultancy, training and institutional capacity-building solutions for government
                    institutions, development organizations, financial institutions, NGOs and private-sector
                    organizations.
                </p>
                <p>
                    Since our founding, we have partnered with clients across Ethiopia and beyond to design and
                    deliver evidence-based programs that strengthen institutions and improve lives.
                </p>
            </div>
            <div class="col-lg-6">
                <h2 class="section-title">Mission &amp; Vision</h2>
                <p><strong>Mission:</strong> To deliver high-quality research, training and consultancy services that help our clients make evidence-based decisions and build lasting institutional capacity.</p>
                <p><strong>Vision:</strong> To be a leading knowledge partner for sustainable development across Ethiopia and the wider region.</p>
            </div>
        </div>

        <div class="row text-center mt-5 g-3">
            <div class="col-6 col-lg-3">
                <span class="impact-number d-block fs-3">8+</span>
