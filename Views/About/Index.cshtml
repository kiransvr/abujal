            </div>
            <div class="col-6 col-lg-3">
                <span class="impact-number d-block fs-3">8+</span>
                <span class="text-muted">Countries Network</span>
            </div>
            <div class="col-6 col-lg-3">
                <span class="impact-number d-block fs-3">100+</span>
                <span class="text-muted">Assignments Delivered</span>
            </div>
        </div>
    </div>
</section>
