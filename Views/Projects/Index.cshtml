@model IReadOnlyList<AbujalWebsite.Models.Project>
@{
    ViewData["Title"] = "Projects";
    var categories = (IReadOnlyList<string>)ViewBag.Categories;
    string? selected = ViewBag.SelectedCategory;
}

<section class="page-header">
    <div class="container">
        <h1>Our Projects</h1>
        <p class="mb-0">A selection of research, training and consultancy assignments delivered across Ethiopia.</p>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="mb-4 d-flex flex-wrap gap-2">
            <a class="btn btn-sm @(selected == null ? "btn-orange" : "btn-outline-navy")" asp-action="Index">All</a>
            @foreach (var category in categories)
            {
                <a class="btn btn-sm @(selected == category ? "btn-orange" : "btn-outline-navy")" asp-action="Index" asp-route-category="@category">@category</a>
            }
        </div>

        @if (!Model.Any())
        {
            <p class="text-muted">No projects found for this category.</p>
        }

        <div class="row g-4">
            @foreach (var project in Model)
            {
                <div class="col-md-4">
                    <div class="project-card">
                        <img src="@project.ImageUrl" alt="@project.Title" />
                        <div class="project-body">
                            <h3>
                                <a class="text-decoration-none" style="color: var(--navy);" asp-action="Details" asp-route-slug="@project.Slug">@project.Title</a>
                            </h3>
                            <p class="text-muted small">@project.Summary</p>
                            <span class="badge badge-category">@project.Category</span>
                            <span class="text-muted small ms-2"><i class="bi bi-geo-alt"></i> @project.Country | @project.Year</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
